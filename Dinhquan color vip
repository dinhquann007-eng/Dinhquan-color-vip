--============================================================
-- FILTER
--============================================================

local IgnoreWords = {
	"quest",
	"mission",
	"chest",
	"treasure",
	"reward",
	"npc",
	"dialog",
	"shop",
	"merchant",
	"interaction",
	"questgiver"
}

local function IsIgnored(obj)

	if not obj then
		return true
	end

	local p = obj

	for _ = 1,8 do

		if not p then
			break
		end

		local n = string.lower(p.Name)

		for _,word in ipairs(IgnoreWords) do

			if string.find(n,word,1,true) then
				return true
			end

		end

		p = p.Parent

	end

	return false
end

--============================================================
-- VFX CHECK
--============================================================

local function IsVFX(obj)

	if not obj or not obj.Parent then
		return false
	end

	if obj:IsDescendantOf(Gui) then
		return false
	end

	if IsIgnored(obj) then
		return false
	end

	return obj:IsA("ParticleEmitter")
		or obj:IsA("Beam")
		or obj:IsA("Trail")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("Highlight")
end

--============================================================
-- APPLY
--============================================================

local function ApplyColor(obj)

	if not Enabled then
		return
	end

	if not IsVFX(obj) then
		return
	end

	pcall(function()

		if obj:IsA("ParticleEmitter") then

			obj.Color = ColorSequence.new(SelectedColor)

			if Neon then
				obj.LightEmission =
					math.max(obj.LightEmission,.35)
			end

		elseif obj:IsA("Beam") then

			obj.Color = ColorSequence.new(SelectedColor)

		elseif obj:IsA("Trail") then

			obj.Color = ColorSequence.new(SelectedColor)

		elseif obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			obj.Color = SelectedColor

		elseif obj:IsA("Highlight") then

			obj.FillColor = SelectedColor
			obj.OutlineColor = SelectedColor

		end

	end)
end

--============================================================
-- LOW-LAG QUEUE
--============================================================

local Queue = {}
local QueueIndex = 1
local Queued = setmetatable({},{
	__mode = "k"
})

local function QueueObject(obj)

	if not IsVFX(obj) then
		return
	end

	if Queued[obj] then
		return
	end

	Queued[obj] = true
	Queue[#Queue+1] = obj

end

local function ScanVFX()

	task.spawn(function()

		for _,obj in ipairs(workspace:GetDescendants()) do

			QueueObject(obj)

			if #Queue % 100 == 0 then
				task.wait()
			end

		end

	end)

end

workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Beam")
		or obj:IsA("Trail")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("Highlight") then

		task.defer(function()
			QueueObject(obj)
		end)

	end

end)

RunService.Heartbeat:Connect(function()

	if not Enabled then
		return
	end

	local count = 0

	while QueueIndex <= #Queue
		and count < MAX_PER_FRAME do

		local obj = Queue[QueueIndex]

		Queue[QueueIndex] = nil
		QueueIndex += 1

		Queued[obj] = nil

		if obj and obj.Parent then
			ApplyColor(obj)
		end

		count += 1

	end

	if QueueIndex > #Queue then
		Queue = {}
		QueueIndex = 1
	end

end)

